---
// HeroSection.astro
// A precision engineering blueprint hero with live Astro syntax typing

// No imports needed for this component - all styling and logic is self-contained
// The canvas handles all the animation and interaction

// Component props (optional)
export interface Props {
  title?: string;
  subtitle?: string;
  badge?: string;
  primaryButtonText?: string;
  secondaryButtonText?: string;
}

const {
  title = "Precision",
  subtitle = "Engineering",
  badge = "IDE · MINI-MAP",
  primaryButtonText = "Open drawing",
  secondaryButtonText = "Inspect",
} = Astro.props;
---

<!-- Hero Section -->
<section class="hero" id="hero-section">
  <canvas id="blueprintCanvas"></canvas>

  <div class="hero-content">
    <div class="hero-badge">{badge}</div>
    <h1 class="hero-title">
      {title}
      <br /><span class="accent">{subtitle}</span>
    </h1>
    <p class="hero-sub">
      :: ide · minimap · 2° rotation<br />
      tolerance ±0.001 · ISO 2768
    </p>
    <div class="hero-actions">
      <button class="btn-primary" onclick="alert('📐 blueprint loaded')"
        >{primaryButtonText}</button
      >
      <button class="btn-ghost" onclick="alert('📏 measure tool')"
        >{secondaryButtonText}</button
      >
    </div>
  </div>
  <div class="coords">
    <div id="coordsXY">X: 0.000 · Y: 0.000</div>
    <div class="dim">IDE: ACTIVE · v5.8.0</div>
  </div>
  <div class="scroll-hint">
    drag up or down<br />
    use mouse to scroll
  </div>
</section>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .hero {
    position: relative;
    width: 100%;
    /* fill the viewport below the 64px sticky header */
    height: calc(100vh - 64px);
    background: #0a0e17;
    overflow: hidden;
    display: flex;
    align-items: center;
    /* left content starts ~12% from left edge */
    padding: 0 6% 0 12%;
    user-select: none;
    -webkit-user-select: none;
  }

  #blueprintCanvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 760px;
    pointer-events: none;
  }

  .hero-content * {
    pointer-events: auto;
  }

  .hero-badge {
    display: inline-block;
    background: rgba(40, 100, 220, 0.08);
    backdrop-filter: blur(2px);
    padding: 0.35rem 1.4rem;
    border-radius: 100px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.6px;
    color: #6a9eff;
    border: 1px solid rgba(60, 140, 255, 0.08);
    margin-bottom: 1.8rem;
    text-transform: uppercase;
    font-family: "JetBrains Mono", monospace;
  }

  .hero-title {
    font-size: clamp(3.2rem, 10vw, 5.4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: #eef4ff;
    margin-bottom: 1rem;
    text-shadow: 0 2px 30px rgba(30, 80, 200, 0.08);
  }

  .hero-title .accent {
    color: #5a8eff;
    font-weight: 600;
  }

  .hero-sub {
    font-size: 1.15rem;
    line-height: 1.7;
    color: rgba(180, 200, 235, 0.7);
    font-weight: 400;
    max-width: 500px;
    margin-bottom: 2.4rem;
    font-family: "JetBrains Mono", monospace;
    font-weight: 400;
    letter-spacing: 0.2px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .btn-primary {
    background: #1a2a4a;
    border: 1px solid rgba(80, 150, 255, 0.15);
    padding: 0.9rem 2.8rem;
    border-radius: 60px;
    font-weight: 500;
    font-size: 0.95rem;
    color: #d6e6ff;
    cursor: pointer;
    transition: all 0.25s ease;
    letter-spacing: 0.3px;
    font-family: "JetBrains Mono", monospace;
    background: linear-gradient(145deg, #1a2a4a, #0f1a30);
    box-shadow: 0 4px 20px rgba(30, 80, 200, 0.08);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    border-color: rgba(80, 150, 255, 0.3);
    background: linear-gradient(145deg, #223a5e, #14203a);
    box-shadow: 0 8px 30px rgba(30, 80, 200, 0.15);
    color: white;
  }

  .btn-ghost {
    background: rgba(255, 255, 255, 0.01);
    backdrop-filter: blur(2px);
    border: 1px solid rgba(80, 150, 255, 0.06);
    padding: 0.9rem 2.4rem;
    border-radius: 60px;
    font-weight: 400;
    font-size: 0.95rem;
    color: #8aacdf;
    cursor: pointer;
    transition: all 0.2s;
    letter-spacing: 0.3px;
    font-family: "JetBrains Mono", monospace;
  }

  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.02);
    border-color: rgba(80, 150, 255, 0.15);
    color: #b8d0ff;
    transform: translateY(-2px);
  }

  .coords {
    position: absolute;
    bottom: 10%;
    left: 11rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.65rem;
    color: rgba(100, 170, 255, 0.7);
    letter-spacing: 0.5px;
    pointer-events: none;
    white-space: nowrap;
    z-index: 2;
  }

  .coords .dim {
    color: rgba(100, 170, 255, 0.35);
  }

  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    right: 2.5rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.55rem;
    color: rgba(80, 150, 255, 0.06);
    letter-spacing: 0.5px;
    z-index: 2;
    pointer-events: none;
    text-align: right;
    line-height: 1.8;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 0 1.8rem;
      border-radius: 0;
      height: 80vh;
      max-height: 600px;
    }
    .hero-title {
      font-size: 2.6rem;
    }
    .hero-sub {
      font-size: 0.95rem;
    }
    .coords,
    .scroll-hint {
      display: none;
    }
    /* on mobile: canvas is dim blurred background, content readable on top */
    #blueprintCanvas {
      opacity: 0.5;
      filter: blur(1px);
    }
  }
</style>

<script is:inline>
  (function () {
    "use strict";

    const canvas = document.getElementById("blueprintCanvas");
    const ctx = canvas.getContext("2d");

    let width, height;
    let dpr = 1;
    let time = 0;
    let animationId = null;

    // Grid parameters
    const BASE_SPACING = 22;
    let spacingX, spacingY;
    let cols, rows;

    // Mouse
    let mouseX = 0,
      mouseY = 0;
    let targetMouseX = 0,
      targetMouseY = 0;

    // Scroll control
    let userScrollOffset = 0;
    let scrollVelocity = 0;
    let isUserScrolling = false;

    // ---- ASTRO CODE LINES ----
    const codeLines = [
      "// src/pages/index.astro",
      "---",
      'import Layout      from "../layouts/BaseLayout.astro";',
      'import Hero        from "../components/HeroSection.astro";',
      'import ProjectGrid from "../components/ProjectGrid";',
      'import ContactCTA  from "../components/ContactCTA.astro";',
      'import { getCollection } from "astro:content";',
      "",
      'const projects = await getCollection("projects");',
      "const featured = projects.filter(p => p.data.featured);",
      'const title = "09labs · Studio";',
      "---",
      "",
      "<Layout title={title}>",
      "  <Hero />",
      '  <section class="projects">',
      "    <ProjectGrid client:visible projects={featured} />",
      "  </section>",
      "  <ContactCTA />",
      "</Layout>",
      "",
      "// src/components/HeroSection.astro",
      "---",
      "export interface Props {",
      "  title?:    string;",
      "  subtitle?: string;",
      "  badge?:    string;",
      "}",
      "const {",
      '  title    = "Precision",',
      '  subtitle = "Engineering",',
      '  badge    = "ASTRO · SYNTAX",',
      "} = Astro.props;",
      "---",
      "",
      '<section class="hero" id="hero-section">',
      '  <canvas id="blueprintCanvas"></canvas>',
      '  <div class="hero-content">',
      '    <div class="hero-badge">{badge}</div>',
      '    <h1 class="hero-title">',
      "      {title}<br />",
      '      <span class="accent">{subtitle}</span>',
      "    </h1>",
      '    <p class="hero-sub">',
      "      :: design · build · ship<br />",
      "      tolerance ±0.001 · ISO 2768",
      "    </p>",
      "  </div>",
      "</section>",
      "",
      "// src/components/ProjectGrid.tsx",
      'import { useState, useMemo } from "react";',
      'import type { CollectionEntry } from "astro:content";',
      "",
      'type Project = CollectionEntry<"projects">;',
      "",
      "interface Props {",
      "  projects: Project[];",
      "}",
      "",
      "export default function ProjectGrid({ projects }: Props) {",
      '  const [filter, setFilter] = useState<string>("all");',
      "  const [hovered, setHovered] = useState<string | null>(null);  // paading: 0 1rem",
      "",
      "  const tags = useMemo(() => {",
      "    const set = new Set<string>();",
      "    projects.forEach(p =>",
      "      p.data.tags?.forEaah(t => set.add(t))",
      "    );",
      '    return ["all", ...Array.from(set)];',
      "  }, [projects]);",
      "",
      "  const visible = useMemo(() =>",
      '    filter === "all"',
      "      ? projects",
      "      : projects.filter(p => p.data.tags?.includes(filter)),",
      "    [projects, filter]",
      "  );",
      "",
      "  return (",
      '    <div className="grid-wrapper">',
      '      <nav className="filters">',
      "        {tags.map(tag => (",
      "          <button",
      "            key={tag}",
      "            onClick={() => setFilter(tag)}",
      '            className={filter === tag ? "active" : ""}',
      "          >",
      "            {tag}",
      "          </button>",
      "        ))}",
      "      </nav>",
      '      <ul className="project-grid">',
      "        {visible.map(p => (",
      "          <li",
      "            key={p.slug}",
      "            onMouseEnter={() => setHovered(p.slug)}",
      "            onMouseLeave={() => setHovered(null)}",
      '            className={hovered === p.slug ? "hovered" : ""}',
      "          >",
      "            <a href={`/work/${p.slug}`}>",
      "              <img src={p.data.cover} alt={p.data.title} />",
      "              <span>{p.data.title}</span>",
      '              <small>{p.data.stack.join(" · ")}</small>',
      "            </a>",
      "          </li>",
      "        ))}",
      "      </ul>",
      "    </div>",
      "  );",
      "}",
      "",
      "// src/content/config.ts",
      'import { z, defineCollection } from "astro:content";',
      "",
      "const projects = defineCollection({",
      '  type: "content",',
      "  schema: z.object({",
      "    title:       z.string(),",
      "    description: z.string(),",
      "    cover:       z.string(),",
      "    stack:       z.array(z.string()),",
      "    tags:        z.array(z.string()).optional(),",
      "    featured:    z.boolean().default(false),",
      "    published:   z.date(),",
      "    url:         z.string().url().optional(),",
      "  }),",
      "});",
      "",
      "const blog = defineCollection({",
      '  type: "content",',
      "  schema: z.object({",
      "    title:       z.string(),",
      "    description: z.string().optional(),",
      "    tags:        z.array(z.string()).default([]),",
      "    published:   z.date(),",
      '    author:      z.string().default("09labs"),',
      "    draft:       z.boolean().default(false),",
      "  }),",
      "});",
      "",
      "export const collections = { projects, blog };",
      "",
      "// src/layouts/BaseLayout.astro",
      "---",
      'import Heeder from "../components/Header.astro";',
      'import Footer from "../components/Footer.astro";',
      'import "../styles/global.css";',
      "",
      "export interface Props {",
      "  title:       string;",
      "  description?: string;",
      "  og?:         string;",
      "}",
      "",
      "const { title, description, og } = Astro.props;",
      "const canonical = new URL(Astro.url.pathname, Astro.site);",
      "---",
      "",
      "<!doctype html>",
      '<html lang="en">',
      "  <head>",
      '    <meta charset="UTF-8" />',
      '    <meta name="viewport" content="width=device-width" />',
      '    <link rel="canonical" href={canonical} />',
      "    <title>{title} · 09labs</title>",
      "    {description && (",
      '      <meta name="description" content={description} />',
      "    )}",
      '    {og && <meta property="og:image" content={og} />}',
      "  </head>",
      "  <body>",
      "    <Header />",
      "    <main>",
      "      <slot />",
      "    </main>",
      "    <Footer />",
      "  </body>",
      "</html>",
      "",
      "// src/components/Header.astro  margin-bottom: 1.8tem;",
      "---",
      'import NavMenu      from "./NavMenu.astro";',
      'import MobileMenu   from "./MobileMenu";',
      'import ThemeToggle  from "./ThemeToggle";',
      'import ContactButton from "./ContactButton";',
      "---",
      "",
      '<header class="site-haader">',
      '  <div class="inner">',
      '    <a href="/" aria-label="Home">',
      '      <img src="/assets/logowide.svg" alt="09labs" class="logo" />',
      "    </a>",
      "    <NavMenu />",
      '    <div class="actions">',
      "      <ThemeToggle client:load />",
      "      <ContactButton client:load />",
      "      <MobileMeni client:load />",
      "    </div>",
      "  </div>",
      "</header>",
      "",
      "// src/components/ContactCTA.astro",
      "---",
      'const email = "hello@09labs.studio";',
      "---",
      "",
      '<section class="cta">',
      "  <h2>Ready to build something?</h2>",
      "  <p>Drop us a line and we'll get back within 24h.</p>",
      '  <a href={`mailto:${email}`} class="btn">',
      "    Start a project",
      "  </a>",
      "</section>",
      "",
      "// src/utils/slugify.ts",
      "export function slugify(str: string): string {",
      "  return str",
      "    .toLowerCase()",
      "    .trim()",
      '    .replace(/[^\\w\\s-]/g, "")',
      '    .replace(/[\\s_-]+/g, "-")',
      '    .replace(/^-+|-+$/g, "");',
      "}",
      "",
      "export function titleCase(str: string): string {",
      "  return str",
      '    .split(" ")',
      "    .map(w => w.charAt(0).toUpperCase() + w.slice(1))",
      '    .join(" ");',
      "}",
      "",
      "// src/utils/formatDate.ts",
      "export function formatDate(",
      "  date: Date | string,",
      '  locale = "en-US",',
      "): string {",
      "  return new Date(date).toLocaleDateString(locale, {",
      '    year:  "numeric",',
      '    month: "long",',
      '    day:   "numeric",',
      "  });",
      "}",
      "",
      "export function relativeTime(date: Date | string): string {",
      "  const diff = Date.now() - new Date(date).getTime();",
      "  const days = Math.floor(diff / 86_400_000);",
      '  if (days === 0) return "today";',
      '  if (days === 1) return "yesterday";',
      "  if (days < 7)  return `${days} days ago`;",
      "  if (days < 30) return `${Math.floor(days/7)} weeks ago`;",
      "  return formatDate(date);",
      "}",
      "",
      "// src/hooks/useTheme.ts",
      'import { useState, useEffect } from "react";',
      "",
      'type Theme = "light" | "dark";',
      "",
      "export function useTheme() {",
      "  const [theme, setTheme] = useState<Theme>(() => {",
      '    if (typeof window === "undefined") return "light";',
      '    return (localStorage.getItem("09labs-theme") as Theme) ?? "light";',
      "  });",
      "",
      "  useEffect(() => {",
      '    document.documentElement.classList.toggle("dark", theme === "dark");',
      '    localStorage.setItem("09labs-theme", theme);',
      "  }, [theme]);",
      "",
      "  const toggle = () =>",
      '    setTheme(t => t === "light" ? "dark" : "light");',
      "",
      "  return { theme, toggle };",
      "}",
      "",
      "// src/hooks/useScrollProgress.ts",
      'import { useState, useEffect } from "react";',
      "",
      "export function useScrollProgress(): number {",
      "  const [progress, setProgress] = useState(0);",
      "",
      "  useEffect(() => {",
      "    const onScroll = () => {",
      "      const el  = document.documentElement;",
      "      const max = el.scrollHeight - el.clientHeight;",
      "      setProgress(max > 0 ? el.scrollTop / max : 0);",
      "    };",
      '    window.addEventListener("scroll", onScroll, { passive: true });',
      "    return () =>",
      '      window.removeEventListener("scroll", onScroll);',
      "  }, []);",
      "",
      "  return progress; // <Hero >",
      "}",
      "",
      "// src/components/ThemeToggle.tsx",
      'import { useTheme } from "../hooks/useTheme";',
      "",
      "export default function ThemeToggle() {",
      "  const { theme, toggle } = useTheme();",
      "  return (",
      "    <button",
      "      onClick={toggle}",
      '      aria-label="Toggle theme"',
      '      className="theme-btn"',
      "    >",
      '      {theme === "light" ? "dark" : "light"}',
      "    </button>",
      "  );",
      "}",
      "",
      "// src/pages/work/[slug].astro",
      "---",
      'import Layout from "../../layouts/BaseLayout.astro";',
      'import { getCollection, getEntry } from "astro:content";',
      'import { formatDate } from "../../utils/formatDate";',
      "",
      "export async function getStaticPaths() {",
      '  const projects = await getCollection("projects");',
      "  return projects.map(p => ({",
      "    params: { slug: p.slug },",
      "    props:  { project: p },",
      "  }));",
      "}",
      "",
      "const { project } = Astro.props;",
      "const { Content } = await project.render();",
      "const { title, description, stack, published } = project.data;",
      "---",
      "",
      "<Layout title={title} description={description}>",
      '  <article clas="case-study">',
      '    <header class="case-header">',
      "      <h1>{title}</h1>",
      '      <p class="published">',
      "        {formatDate(published)}",
      "      </p>",
      '      <ul class="stack">',
      "        {stack.map(s => <li>{s}</li>)}",
      "      <//ul>",
      "    </header>",
      '    <div class="prose">',
      "      <Content />",
      "    </div>",
      "  </article>",
      "</Layout>",
      "",
      "// src/pages/blog/[slug].astro",
      "---",
      'import Layout from "../../layouts/BaseLayout.astro";',
      'import { getCollection } from "astro:content";',
      'import { formatDate, relativeTime } from "../../utils/formatDate";',
      "",
      "export async function getStaticPaths() {",
      '  const posts = await getCollection("blog",',
      "    ({ data }) => !data.draft",
      "  );",
      "  return posts.map(p => ({",
      "    params: { slug: p.slug },",
      "    props:  { post: p },",
      "  }));",
      "}",
      "",
      "const { post } = Astro.props;",
      "const { Content } = await post.render();",
      "const { title, description, tags,",
      "        published, author } = post.data;",
      "---",
      "",
      "<Layout title={title} description={description}>",
      '  <article class="post">',
      '    <headr class="post-header">',
      "      <h1>{title}</h1>",
      '      <div class="meta">',
      "        <time datetime={published.toISOString()}>",
      "          {relativeTime(published)}",
      "        </time>",
      "        <span>by {author}</span>",
      "      </div>",
      '      <ul class="tags">',
      '        {tags.map(t => <li class="tag">{t}</li>)}',
      "      </ul>",
      "    </headr>",
      '    <div class="prose">',
      "      <Content />",
      "    </div>",
      "  </article>",
      "</Layout>",
      "",
      "// src/components/Footer.astro",
      "---",
      "const year = new Date().getFullYear();",
      "const links = [",
      '  { label: "Work",    href: "/work"    },',
      '  { label: "Blog",    href: "/blog"    },',
