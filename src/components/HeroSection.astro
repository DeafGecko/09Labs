      "      )}",
      "    </article>",
      "  </main>",
      "</Layout>",
      "",
      "<style>",
      "  .container {",
      "    max-width: 768px;",
      "    margin: 0 auto;",
      "    padding: 2rem 1rem;",
      "  }",
      "",
      "  .post-header {",
      "    margin-bottom: 2.5rem;",
      "    border-bottom: 1px solid var(--border-color);",
      "    padding-bottom: 1.5rem;",
      "  }",
      "",
      "  .post-title {",
      "    font-size: 2.5rem;",
      "    font-weight: 700;",
      "    line-height: 1.2;",
      "    margin-bottom: 0.75rem;",
      "    background: linear-gradient(135deg, #fff 0%, #8899ff 100%);",
      "    -webkit-background-clip: text;",
      "    background-clip: text;",
      "    color: transparent;",
      "  }",
      "",
      "  .post-meta {",
      "    display: flex;",
      "    gap: 1rem;",
      "    color: var(--text-muted);",
      "    font-size: 0.875rem;",
      "    margin-bottom: 0.75rem;",
      "  }",
      "",
      "  .post-tags {",
      "    display: flex;",
      "    gap: 0.5rem;",
      "    flex-wrap: wrap;",
      "  }",
      "",
      "  .tag {",
      "    background: var(--tag-bg);",
      "    padding: 0.25rem 0.75rem;",
      "    border-radius: 999px;",
      "    font-size: 0.75rem;",
      "    color: var(--tag-text);",
      "    border: 1px solid var(--tag-border);",
      "  }",
      "",
      "  .post-content {",
      "    font-size: 1.125rem;",
      "    line-height: 1.8;",
      "  }",
      "",
      "  .post-content :deep(h2) {",
      "    font-size: 1.75rem;",
      "    margin-top: 2.5rem;",
      "    margin-bottom: 1rem;",
      "  }",
      "",
      "  .post-content :deep(h3) {",
      "    font-size: 1.375rem;",
      "    margin-top: 2rem;",
      "    margin-bottom: 0.75rem;",
      "  }",
      "",
      "  .post-content :deep(p) {",
      "    margin-bottom: 1.25rem;",
      "  }",
      "",
      "  .post-content :deep(ul) {",
      "    margin-bottom: 1.25rem;",
      "    padding-left: 1.5rem;",
      "  }",
      "",
      "  .related-posts {",
      "    margin-top: 3rem;",
      "    padding-top: 2rem;",
      "    border-top: 1px solid var(--border-color);",
      "  }",
      "",
      "  .related-grid {",
      "    display: grid;",
      "    gap: 1.5rem;",
      "    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));",
      "    margin-top: 1.5rem;",
      "  }",
      "</style>",
    ];

    // Typing state
    // pre-fill 60 lines so minimap shows content on load
    let currentLineIndex = 45 % codeLines.length;
    let charIndex = 0;
    let allTypedLines = codeLines
      .slice(0, 45)
      .map((_, i) => codeLines[i % codeLines.length]);
    let isTyping = true;
    let isPaused = false;
    let pauseTimer = 0;
    let scrollOffset = 0;
    const LINE_HEIGHT = 20;
    const MAX_LINES = 350;

    let currentTypingSpeed = 900;
    let speedChangeTimer = 0;
    const SPEED_CHANGE_INTERVAL = 2000;

    // 3-second speed burst at start so visitor sees action immediately
    const BURST_SPEED = 3600;
    const BURST_DURATION = 3000;
    const burstStart = performance.now();
    let inBurst = true;

    let pauseDuration = 0;
    let linesSinceLastPause = 0;
    let charsSinceLastPause = 0;

    // Error simulation — fake typo, pause, delete back, resume
    // phases: 'none' | 'inserted' | 'deleting' | 'done'
    let errPhase = "none";
    let errTimer = 0;
    let errDeleteCount = 0;
    let errInserted = "";
    let errTriggerCount = 0;
    const ERR_MAX = 5; // trigger 5 times per cycle
    let nextErrLine = 0; // which line index triggers next error
    const ERR_TYPOS = ["!!!", "}}};", "  ???", "XYZZ", "<<<!"];
    function pickNextErrLine() {
      // spread errors roughly evenly across 250 lines
      const gap = Math.floor(MAX_LINES / ERR_MAX);
      nextErrLine = allTypedLines.length + gap + Math.floor(Math.random() * 10);
    }
    pickNextErrLine();

    // 3 warn lines at 63, 180, 295 (0-indexed: 62, 179, 294)
    const WARN_LINES_BEFORE_FIX = 5;
    const WARN_DEFS = [
      { line: 62, fixed: false },
      { line: 180, fixed: false },
      { line: 293, fixed: false },
      { line: 340, fixed: false },
    ];

    // which warn is currently being processed (0, 1, 2) or -1 = none
    let activeWarnIdx = -1;
    let warnPhase = "none";
    let warnFixTimer = 0;

    // Hover state
    let hoveredLineIndex = -1;
    let hoveredTokenIndex = -1;
    let mouseCanvasX = -1;
    let mouseCanvasY_global = -1;
    // built each frame: [{line, tok, x, y, w}]
    const tokenHitCache = [];

    // Syntax lines for background
    let syntaxLines = [];

    function generateSyntaxLines() {
      syntaxLines = [];
      const count = 20 + Math.floor(Math.random() * 12);
      const labels = ["DIM", "TOL", "REF", "ANG", "RAD", "DIA"];
      for (let i = 0; i < count; i++) {
        const x = Math.random() * width;
        const y = Math.random() * height;
        const length = 30 + Math.random() * 120;
        const angle = Math.random() * Math.PI * 2;
        const label = labels[Math.floor(Math.random() * labels.length)];

        syntaxLines.push({
          x,
          y,
          length,
          angle,
          label,
          alpha: 0.02 + Math.random() * 0.035,
          speed: 0.15 + Math.random() * 0.3,
          phase: Math.random() * Math.PI * 2,
          width: 0.2 + Math.random() * 0.3,
          hasCircle: Math.random() > 0.5,
        });
      }
    }

    function resizeCanvas() {
      const rect = canvas.parentElement.getBoundingClientRect();
      width = rect.width;
      height = rect.height;

      dpr = window.devicePixelRatio || 1;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = width + "px";
      canvas.style.height = height + "px";
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.scale(dpr, dpr);

      spacingX = Math.max(BASE_SPACING, width / 52);
      spacingY = Math.max(BASE_SPACING, height / 38);
      cols = Math.floor(width / spacingX) + 4;
      rows = Math.floor(height / spacingY) + 4;

      generateSyntaxLines();
    }

    function handleMouseMove(e) {
      const rect = canvas.getBoundingClientRect();
      let mx = (e.clientX - rect.left) / rect.width;
      let my = (e.clientY - rect.top) / rect.height;
      targetMouseX = (mx - 0.5) * 2;
      targetMouseY = (my - 0.5) * 2;

      // store raw canvas coords for per-token hit test
      mouseCanvasX = e.clientX - rect.left;
      mouseCanvasY_global = e.clientY - rect.top;

      // track if mouse is over IDE area (right side, x > 44% of canvas)
      mouseOverIDE = mx > 0.44;

      // live X/Y display
      const coordEl = document.getElementById("coordsXY");
      if (coordEl) {
        const nx = (mx * 10 - 5).toFixed(3);
        const ny = (my * 10 - 5).toFixed(3);
        coordEl.textContent = `X: ${nx} · Y: ${ny}`;
      }

      // hit-test against cached token positions from last frame
      hoveredLineIndex = -1;
      hoveredTokenIndex = -1;
      if (isUserScrolling) return;
      for (let i = 0; i < tokenHitCache.length; i++) {
        const t = tokenHitCache[i];
        if (
          mouseCanvasX >= t.x &&
          mouseCanvasX <= t.x + t.w &&
          mouseCanvasY_global >= t.y - 10 &&
          mouseCanvasY_global <= t.y + 3
        ) {
          hoveredLineIndex = t.line;
          hoveredTokenIndex = t.tok;
          break;
        }
      }
    }

    function handleMouseLeave() {
      targetMouseX = 0;
      targetMouseY = 0;
      mouseCanvasX = -1;
      mouseCanvasY_global = -1;
      hoveredLineIndex = -1;
      hoveredTokenIndex = -1;
      mouseOverIDE = false;
      const coordEl = document.getElementById("coordsXY");
      if (coordEl) coordEl.textContent = "X: 0.000 · Y: 0.000";
    }

    let scrollStopTimer = null;
    let mouseOverIDE = false;
    function handleWheel(e) {
      // only scroll the IDE when mouse is over the right-side canvas area
      if (!mouseOverIDE) return;
      e.preventDefault();
      const delta = e.deltaY || e.detail || 0;
      scrollVelocity += delta * 1.2;
      isUserScrolling = true;
      clearTimeout(scrollStopTimer);
      scrollStopTimer = setTimeout(() => {
        isUserScrolling = false;
        scrollVelocity = 0;
      }, 1200);
    }

    // ---- PRETTIER SYNTAX HIGHLIGHTER ----
    function highlightPrettier(line) {
      if (!line || line.trim() === "") {
        return [{ text: line || "", color: "rgba(255,255,255,0)" }];
      }

      const tokens = [];
      let remaining = line;
      let i = 0;

      const pushToken = (text, color) => {
        if (text) {
          tokens.push({ text, color });
        }
      };

      const patterns = [
        {
          regex: /^---/,
          color: "rgba(255, 200, 100, 0.6)",
          type: "frontmatter",
        },
        {
          regex: /\/\/.*$/,
          color: "rgba(130, 180, 100, 0.7)",
          type: "comment",
        },
        {
          regex: /"([^"\\]|\\.)*"/,
          color: "rgba(200, 180, 80, 0.8)",
          type: "string",
        },
        {
          regex: /'([^'\\]|\\.)*'/,
          color: "rgba(200, 180, 80, 0.8)",
          type: "string",
        },
        {
          regex: /`([^`\\]|\\.)*`/,
          color: "rgba(200, 180, 80, 0.8)",
          type: "string",
        },
        {
          regex: /\b\d+\.?\d*\b/,
          color: "rgba(210, 160, 255, 0.8)",
          type: "number",
        },
        {
          regex:
            /\b(import|export|from|const|let|var|function|return|if|else|for|while|do|switch|case|break|continue|new|class|interface|type|enum|extends|implements|typeof|instanceof|void|delete|in|of|await|async|yield|try|catch|finally|throw|default)\b/,
          color: "rgba(200, 120, 255, 0.8)",
          type: "keyword",
        },
        {
          regex:
            /\b(Astro|getCollection|getEntry|getEntryBySlug|render|slot|Content|islands)\b/,
          color: "rgba(97, 219, 251, 0.9)",
          type: "astro",
        },
        {
          regex: /<\/?[a-zA-Z][a-zA-Z0-9-]*>/,
          color: "rgba(97, 219, 251, 0.7)",
          type: "tag",
        },
        {
          regex:
            /\b(className|ref|onClick|onChange|onSubmit|style|key|id|type|value|placeholder|disabled|checked|selected|defaultValue|defaultChecked|htmlFor|dangerouslySetInnerHTML|title|description|tags|published|author|url|datetime|slot|client:load|client:idle|client:visible)\b/,
          color: "rgba(255, 150, 100, 0.8)",
          type: "attribute",
        },
        {
          regex:
            /\b(useState|useEffect|useRef|useCallback|useMemo|useContext|useReducer|useLayoutEffect|useImperativeHandle|useDebugValue|useTransition|useDeferredValue|useId)\b/,
          color: "rgba(97, 219, 251, 0.9)",
          type: "hook",
        },
        {
          regex:
            /\b(Partial|Required|Readonly|Record|Pick|Omit|Exclude|Extract|NonNullable|ReturnType|InstanceType|Parameters|ConstructorParameters)\b/,
          color: "rgba(130, 220, 180, 0.8)",
          type: "utility",
        },
        {
          regex: /\b(true|false|null|undefined)\b/,
          color: "rgba(210, 160, 255, 0.8)",
          type: "boolean",
        },
        {
          regex:
            /\b(display|margin|padding|width|height|max-width|min-width|max-height|min-height|color|background|border|font-size|font-weight|line-height|text-align|position|top|left|right|bottom|flex|grid|gap|align-items|justify-content)\b/,
          color: "rgba(255, 200, 150, 0.7)",
          type: "css",
        },
        {
          regex:
            /\b(auto|block|inline|flex|grid|relative|absolute|fixed|static|sticky|cover|contain|center|start|end|space-between|space-around|wrap|nowrap|column|row)\b/,
          color: "rgba(180, 200, 150, 0.7)",
          type: "css-value",
        },
      ];

      while (i < remaining.length) {
        let matched = false;

        for (const pattern of patterns) {
          const regex = pattern.regex;
          regex.lastIndex = 0;
          const match = regex.exec(remaining.substring(i));
          if (match && match.index === 0) {
            pushToken(match[0], pattern.color);
            i += match[0].length;
            matched = true;
            break;
          }
        }

        if (!matched) {
          const char = remaining[i];
          if (/[{}()\[\]<>;:,.]/.test(char)) {
            pushToken(char, "rgba(180, 180, 220, 0.5)");
          } else if (/[=+\-*/%&|^~!]/.test(char)) {
            pushToken(char, "rgba(255, 200, 150, 0.6)");
          } else if (char === " ") {
            pushToken(char, "rgba(255,255,255,0.1)");
          } else {
            pushToken(char, "rgba(180, 200, 220, 0.7)");
          }
          i++;
        }
      }

      return tokens;
    }

    // ---- TYPING UPDATE ----
    function updateTyping(timestamp) {
      if (!isTyping) return;

      if (isPaused) {
        if (timestamp - pauseTimer > pauseDuration) {
          isPaused = false;
          linesSinceLastPause = 0;
          charsSinceLastPause = 0;
        }
        return;
      }

      if (
        timestamp - speedChangeTimer >
        SPEED_CHANGE_INTERVAL + Math.random() * 2000
      ) {
        const speeds = [880, 900, 920, 940, 960, 980, 1000];
        currentTypingSpeed = speeds[Math.floor(Math.random() * speeds.length)];
        speedChangeTimer = timestamp;
      }

      // use burst speed for first 3 seconds
      if (inBurst && performance.now() - burstStart > BURST_DURATION) {
        inBurst = false;
      }
      const activeSpeed = inBurst ? BURST_SPEED : currentTypingSpeed;
      const charsPerSecond = (activeSpeed * 10) / 60;
      const charsPerFrame = charsPerSecond / 60;

      const charsToType = charsPerFrame;
      let charsTyped = 0;

      while (charsTyped < charsToType && isTyping && !isPaused) {
        // stop when all code lines exhausted (seamless loop resets above)
        if (currentLineIndex >= codeLines.length) {
          isTyping = false;
          break;
        }

        const currentLine = codeLines[currentLineIndex];
        if (!currentLine) {
          currentLineIndex++;
          continue;
        }

        // --- error simulation ---
        if (errPhase === "inserted") {
          // deleting the typo chars one per tick
          if (errInserted.length > 0) {
            errInserted = errInserted.slice(0, -1);
          } else {
            errPhase = "none";
            errTriggerCount++;
            pickNextErrLine();
          }
          charsTyped++;
          continue;
        }

        if (
          errPhase === "none" &&
          errTriggerCount < ERR_MAX &&
          allTypedLines.length >= nextErrLine &&
          charIndex > 4
        ) {
          // inject a random typo at end of current typed position
          const typo = ERR_TYPOS[errTriggerCount % ERR_TYPOS.length];
          errInserted = typo;
          errPhase = "inserted";
          // pause briefly so viewer sees the error
          isPaused = true;
          pauseTimer = timestamp;
          pauseDuration = 350;
          return;
        }

        if (charIndex < currentLine.length) {
          charIndex++;
          charsTyped++;
          charsSinceLastPause++;
        } else {
          allTypedLines.push(currentLine);
          currentLineIndex++;
          charIndex = 0;
          linesSinceLastPause++;
        }
      }
    }

    // ---- DRAW ----
    function drawBlueprint(timestamp) {
      // ---- FINAL-STOP STATE MACHINE (warn lines are passive — never interrupt typing) ----
      // Seamless loop — when codeLines exhausted, silently wrap back to line 1
      if (currentLineIndex >= codeLines.length) {
        allTypedLines = [];
        currentLineIndex = 0;
        charIndex = 0;
        scrollOffset = 0;
        userScrollOffset = 0;
        errPhase = "none";
        errInserted = "";
        errTriggerCount = 0;
        pickNextErrLine();
        activeWarnIdx = -1;
      }

      {
        // typing runs freely, warn lines are just passive red markers
        isTyping = true;
      }

      updateTyping(timestamp);

      const viewportStart = height * 0.08;
      const viewportEnd = height * 0.96;
      const viewportHeight = viewportEnd - viewportStart;
      const visibleLines = Math.floor(viewportHeight / LINE_HEIGHT);
      const totalLines = allTypedLines.length;
      const maxScroll = Math.max(0, totalLines * LINE_HEIGHT - viewportHeight);
      const autoTarget =
        totalLines > visibleLines
          ? (totalLines - visibleLines) * LINE_HEIGHT
          : 0;

      if (isUserScrolling || Math.abs(scrollVelocity) > 0.5) {
        // apply wheel velocity directly to scrollOffset
        scrollOffset += scrollVelocity * 0.016;
        scrollVelocity *= 0.85;
        if (Math.abs(scrollVelocity) < 0.5) scrollVelocity = 0;
        scrollOffset = Math.max(0, Math.min(maxScroll, scrollOffset));
        userScrollOffset = scrollOffset;
      } else {
        // auto-follow new lines being typed, unless hovering
        if (hoveredLineIndex < 0) {
          // if user scrolled up, gradually drift back to auto position
          if (userScrollOffset > 0 && autoTarget > userScrollOffset) {
            userScrollOffset = 0;
          }
          if (userScrollOffset > 0) {
            // stay pinned where user left it
            scrollOffset = Math.min(userScrollOffset, maxScroll);
          } else {
            scrollOffset += (autoTarget - scrollOffset) * 0.06;
          }
        }
      }

      mouseX += (targetMouseX - mouseX) * 0.06;
      mouseY += (targetMouseY - mouseY) * 0.06;
      time += 0.008;

      const mx = width * (mouseX * 0.5 + 0.5);
      const my = height * (mouseY * 0.5 + 0.5);
      const centerX = width / 2;
      const centerY = height / 2;

      // Background
      const bgGrad = ctx.createRadialGradient(
        width * 0.5,
        height * 0.5,
        0,
        width * 0.5,
        height * 0.5,
        width * 0.9,
      );
      bgGrad.addColorStop(0, "#161d2b");
      bgGrad.addColorStop(0.5, "#0e121c");
      bgGrad.addColorStop(1, "#080b11");
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, width, height);

      // ---- GRID LINES ----
      const gridPulse = 0.5 + 0.5 * Math.sin(time * 0.5);

      for (let x = 0; x <= width; x += spacingX) {
        const distFromCenterX = Math.abs(x - centerX) / (width * 0.5);
        const baseAlpha = 0.03 * Math.max(0, 1 - distFromCenterX * 1.1);
        const pulseAlpha = baseAlpha * (0.6 + 0.4 * gridPulse);
        const edgeFadeX = Math.min(
          (x - 0) / (width * 0.1),
          (width - x) / (width * 0.1),
          1,
        );
        const finalAlpha = pulseAlpha * Math.min(1, edgeFadeX * 1.5);

        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, height);
        ctx.strokeStyle = `rgba(70, 150, 255, ${finalAlpha * 0.6})`;
        ctx.lineWidth = 0.3;
        ctx.stroke();
      }

      for (let y = 0; y <= height; y += spacingY) {
        const distFromCenterY = Math.abs(y - centerY) / (height * 0.5);
        const baseAlpha = 0.03 * Math.max(0, 1 - distFromCenterY * 1.1);
        const pulseAlpha = baseAlpha * (0.6 + 0.4 * (1 - gridPulse));
        const edgeFadeY = Math.min(
          (y - 0) / (height * 0.1),
          (height - y) / (height * 0.1),
          1,
        );
        const finalAlpha = pulseAlpha * Math.min(1, edgeFadeY * 1.5);

        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(width, y);
        ctx.strokeStyle = `rgba(70, 150, 255, ${finalAlpha * 0.6})`;
        ctx.lineWidth = 0.3;
        ctx.stroke();
      }

      // ---- DIAGONAL LINES ----
      ctx.lineWidth = 0.2;
      const diagSpacing = spacingX * 2.5;
      for (let i = -rows; i < cols + rows; i++) {
        const x1 = i * diagSpacing;
        const y1 = 0;
        const x2 = i * diagSpacing + height;
        const y2 = height;
        const midX = (x1 + x2) / 2;
        const midY = (y1 + y2) / 2;
        const dist =
          Math.hypot(midX - centerX, midY - centerY) /
          (Math.min(width, height) * 0.5);
        const alpha = 0.006 * Math.max(0, 1 - dist * 1.2);
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.strokeStyle = `rgba(80, 160, 255, ${alpha})`;
        ctx.stroke();
      }

      for (let i = -rows; i < cols + rows; i++) {
        const x1 = i * diagSpacing;
        const y1 = height;
        const x2 = i * diagSpacing + height;
        const y2 = 0;
        const midX = (x1 + x2) / 2;
        const midY = (y1 + y2) / 2;
        const dist =
          Math.hypot(midX - centerX, midY - centerY) /
          (Math.min(width, height) * 0.5);
        const alpha = 0.006 * Math.max(0, 1 - dist * 1.2);
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.strokeStyle = `rgba(80, 160, 255, ${alpha})`;
        ctx.stroke();
      }

      // ---- SYNTAX ANNOTATION LINES ----
      for (let i = 0; i < syntaxLines.length; i++) {
        const line = syntaxLines[i];
        const offsetX = Math.sin(time * line.speed + line.phase) * 4;
        const offsetY = Math.cos(time * line.speed * 0.7 + line.phase) * 4;

        const x = line.x + offsetX;
        const y = line.y + offsetY;
        const angle = line.angle + Math.sin(time * 0.2 + i) * 0.02;

        const endX = x + Math.cos(angle) * line.length;
        const endY = y + Math.sin(angle) * line.length;

        const pulse = 0.5 + 0.5 * Math.sin(time * 0.3 + line.phase);
        const alpha = line.alpha * (0.4 + 0.6 * pulse);

        ctx.beginPath();
        ctx.moveTo(x, y);
        ctx.lineTo(endX, endY);
        ctx.strokeStyle = `rgba(100, 180, 255, ${alpha * 0.5})`;
        ctx.lineWidth = line.width;
        ctx.stroke();

        if (line.hasCircle) {
          ctx.beginPath();
          ctx.arc(x, y, 1.2, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(100, 180, 255, ${alpha * 0.3})`;
          ctx.fill();
        }

        const midX = (x + endX) / 2 + Math.sin(angle + 1.2) * 10;
        const midY = (y + endY) / 2 + Math.cos(angle + 1.2) * 10;
        ctx.font = "5px JetBrains Mono, monospace";
        ctx.fillStyle = `rgba(100, 180, 255, ${alpha * 0.35})`;
        ctx.fillText(line.label, midX - 8, midY + 2);
      }

      // ---- GRID NODES ----
      for (let x = spacingX; x < width - spacingX; x += spacingX * 1.5) {
        for (let y = spacingY; y < height - spacingY; y += spacingY * 1.5) {
          const dist =
            Math.hypot(x - centerX, y - centerY) /
            (Math.min(width, height) * 0.5);
          const alpha = 0.015 * Math.max(0, 1 - dist * 1.3);
          if (alpha < 0.002) continue;

          const pulse = 0.5 + 0.5 * Math.sin(time * 0.7 + x * 0.01 + y * 0.01);
          ctx.beginPath();
          ctx.arc(x, y, 0.6 + 0.4 * pulse, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(80, 170, 255, ${alpha * (0.5 + 0.5 * pulse)})`;
          ctx.fill();
        }
      }

      // ---- INTERACTIVE CROSSHAIR ----
      const crossAlpha =
        0.04 + 0.08 * (1 - Math.min(1, Math.hypot(mouseX, mouseY) * 0.5));
      ctx.lineWidth = 0.4;
      ctx.strokeStyle = `rgba(100, 180, 255, ${crossAlpha})`;
      ctx.setLineDash([2, 6]);
      ctx.beginPath();
      ctx.moveTo(0, my);
      ctx.lineTo(width, my);
      ctx.moveTo(mx, 0);
      ctx.lineTo(mx, height);
      ctx.stroke();
      ctx.setLineDash([]);

      for (let r = 30; r < Math.min(width, height) * 0.4; r += 30) {
        const ringAlpha = 0.01 * (1 - r / (Math.min(width, height) * 0.4));
        if (ringAlpha < 0.001) break;
        ctx.beginPath();
        ctx.arc(mx, my, r, 0, Math.PI * 2);
        ctx.strokeStyle = `rgba(80, 160, 255, ${ringAlpha})`;
        ctx.lineWidth = 0.2;
        ctx.stroke();
      }

      // ---- DIMENSION TICKS ----
      ctx.lineWidth = 0.3;
      for (let x = 0; x <= width; x += spacingX * 2) {
        const distFromCenterX = Math.abs(x - centerX) / (width * 0.5);
        const alpha = 0.025 * Math.max(0, 1 - distFromCenterX * 0.8);
        if (alpha < 0.002) continue;
        ctx.beginPath();
        ctx.moveTo(x, centerY - 4);
        ctx.lineTo(x, centerY + 4);
        ctx.strokeStyle = `rgba(70, 150, 255, ${alpha})`;
        ctx.stroke();
      }
      for (let y = 0; y <= height; y += spacingY * 2) {
        const distFromCenterY = Math.abs(y - centerY) / (height * 0.5);
        const alpha = 0.025 * Math.max(0, 1 - distFromCenterY * 0.8);
        if (alpha < 0.002) continue;
        ctx.beginPath();
        ctx.moveTo(centerX - 4, y);
        ctx.lineTo(centerX + 4, y);
        ctx.strokeStyle = `rgba(70, 150, 255, ${alpha})`;
        ctx.stroke();
      }

      ctx.strokeStyle = "rgba(60, 140, 255, 0.03)";
      ctx.lineWidth = 0.3;
      const cSize = 8;
      ctx.beginPath();
      ctx.moveTo(centerX - cSize, centerY);
      ctx.lineTo(centerX + cSize, centerY);
      ctx.moveTo(centerX, centerY - cSize);
      ctx.lineTo(centerX, centerY + cSize);
      ctx.stroke();

      // ---- LIVE TYPING SYNTAX + MINIMAP (rotated 5°) ----
      ctx.save();
      // rotate around the center-right of the panel
      const pivotX = width * 0.72;
      const pivotY = height * 0.5;
      ctx.translate(pivotX, pivotY);
      ctx.rotate((2 * Math.PI) / 180);
      ctx.translate(-pivotX, -pivotY);

      const startX = width * 0.44;
      const startY = height * 0.08;

      const currentTypingLine = codeLines[currentLineIndex]
        ? codeLines[currentLineIndex].substring(0, charIndex)
        : "";

      const effectiveScroll = scrollOffset;

      // Rebuild token hit cache every frame
      tokenHitCache.length = 0;

      // Draw all completed lines
      for (let i = 0; i < totalLines; i++) {
        const line = allTypedLines[i];
        const yPos = startY + i * LINE_HEIGHT - effectiveScroll;

        if (yPos < viewportStart - LINE_HEIGHT || yPos > viewportEnd) continue;

        const centerDist = (yPos - height * 0.5) / (height * 0.3);
        const alpha = Math.max(0, 1 - Math.abs(centerDist) * 0.7) * 0.85;
        if (alpha < 0.01) continue;

        const tokens = highlightPrettier(line);
        let xPos = startX;
        ctx.font = "14px JetBrains Mono, monospace";

        const isHoveredLine = i === hoveredLineIndex;

        // full-line blue background when this line is hovered
        if (isHoveredLine) {
          ctx.save();
          ctx.fillStyle = "rgba(60, 120, 255, 0.12)";
          ctx.fillRect(
            startX - 32,
            yPos - LINE_HEIGHT + 3,
            width - startX + 28,
            LINE_HEIGHT,
          );
          ctx.restore();
        }

        tokens.forEach((token, ti) => {
          const tw = ctx.measureText(token.text).width;

          // cache position for hit testing next mousemove
          if (token.text.trim()) {
            tokenHitCache.push({ line: i, tok: ti, x: xPos, y: yPos, w: tw });
          }

          const isThisHovered = isHoveredLine && ti === hoveredTokenIndex;
          let color;

          if (isThisHovered && token.text.trim()) {
            // hovered token: yellow or purple, bright glow
            color =
              ti % 2 === 0 ? "rgba(255, 230, 50, 1)" : "rgba(220, 80, 255, 1)";
            ctx.save();
            ctx.shadowColor =
              ti % 2 === 0 ? "rgba(255,230,50,0.6)" : "rgba(200,60,255,0.6)";
            ctx.shadowBlur = 8;
            ctx.fillStyle = color;
            ctx.fillText(token.text, xPos, yPos);
            ctx.restore();
          } else if (isHoveredLine && token.text.trim()) {
            // rest of hovered line: render at full alpha, slightly brighter
            const parts = token.color.match(/[\d.]+/g);
            if (parts && parts.length >= 3) {
              color = `rgba(${parts[0]},${parts[1]},${parts[2]},1)`;
            } else {
              color = token.color;
            }
            ctx.fillStyle = color;
            ctx.fillText(token.text, xPos, yPos);
          } else {
            const parts = token.color.match(/[\d.]+/g);
            if (parts && parts.length >= 3) {
              const baseA = parseFloat(parts[3] ?? "0.7");
              color = `rgba(${parts[0]},${parts[1]},${parts[2]},${Math.min(baseA * alpha, 1)})`;
            } else {
              color = token.color;
            }
            ctx.fillStyle = color;
            ctx.fillText(token.text, xPos, yPos);
          }

          xPos += tw;
        });

        ctx.font = "9px JetBrains Mono, monospace";
        ctx.fillStyle = `rgba(80, 150, 255, ${alpha * 0.55})`;
        ctx.fillText(
          (i + 1).toString().padStart(3, " "),
          startX - 28,
          yPos + 2,
        );

        // warn lines — red gutter marker while unfixed, green once fixed
        const warnDef = WARN_DEFS.find((w) => w.line === i);
        if (warnDef && allTypedLines.length > i) {
          const isActiveFixing =
            !warnDef.fixed &&
            warnPhase === "fixing" &&
            WARN_DEFS[activeWarnIdx]?.line === i;
          ctx.save();
          if (warnDef.fixed || isActiveFixing) {
            const fPulse = warnDef.fixed ? 0.5 : 0.7 + 0.3 * Math.sin(time * 8);
            ctx.shadowColor = "rgba(60,220,100,0.9)";
            ctx.shadowBlur = 10;
            ctx.fillStyle = `rgba(60,220,100,${fPulse})`;
            ctx.fillText("ok", startX - 50, yPos + 2);
            ctx.fillStyle = `rgba(60,220,100,0.06)`;
            ctx.fillRect(
              startX - 32,
              yPos - LINE_HEIGHT + 2,
              width - startX + 28,
              LINE_HEIGHT,
            );
          } else {
            const wPulse = 0.7 + 0.3 * Math.sin(time * 4);
            ctx.shadowColor = "rgba(255,60,60,0.9)";
            ctx.shadowBlur = 8;
            ctx.fillStyle = `rgba(255,80,80,${wPulse})`;
            ctx.fillText("!!", startX - 50, yPos + 2);
            ctx.fillStyle = `rgba(255,60,60,0.07)`;
            ctx.fillRect(
              startX - 32,
              yPos - LINE_HEIGHT + 2,
              width - startX + 28,
              LINE_HEIGHT,
            );
          }
          ctx.restore();
        }
      }

      // Display current typing line
      if (currentTypingLine) {
        const yPos = startY + totalLines * LINE_HEIGHT - effectiveScroll;

        if (yPos >= viewportStart && yPos <= viewportEnd) {
          const centerDist = (yPos - height * 0.5) / (height * 0.3);
          let alpha = Math.max(0, 1 - Math.abs(centerDist) * 0.7) * 0.95;

          const showCursor = Math.floor(Date.now() / 500) % 2 === 0;

          const tokens = highlightPrettier(currentTypingLine);
          let xPos = startX;
          ctx.font = "14px JetBrains Mono, monospace";

          for (const token of tokens) {
            let color = token.color;
            const tokenAlpha = token.color.includes("0.")
              ? parseFloat(token.color.split(",")[3]?.trim() || "0.7") * alpha
              : alpha * 0.9;

            if (color.includes("rgba")) {
              const parts = color.match(/[\d.]+/g);
              if (parts && parts.length >= 3) {
                const r = parts[0],
                  g = parts[1],
                  b = parts[2];
                color = `rgba(${r}, ${g}, ${b}, ${Math.min(tokenAlpha, 1)})`;
              }
            } else if (color.includes("rgb")) {
              color = color
                .replace("rgb", "rgba")
                .replace(")", `, ${Math.min(tokenAlpha, 1)})`);
            }

            ctx.fillStyle = color;
            ctx.fillText(token.text, xPos, yPos);
            xPos += ctx.measureText(token.text).width;
          }

          // draw error typo in red with yellow squiggle underline
          if (errInserted) {
            ctx.save();
            ctx.font = "14px JetBrains Mono, monospace";
            ctx.shadowColor = "rgba(255, 60, 60, 0.8)";
            ctx.shadowBlur = 6;
            ctx.fillStyle = "rgba(255, 80, 80, 1)";
            ctx.fillText(errInserted, xPos, yPos);
            const errW = ctx.measureText(errInserted).width;
            // yellow squiggle underline
            ctx.shadowBlur = 0;
            ctx.strokeStyle = "rgba(255, 210, 0, 0.9)";
            ctx.lineWidth = 1.2;
            ctx.setLineDash([2, 2]);
            ctx.beginPath();
            ctx.moveTo(xPos, yPos + 3);
            for (let wx = 0; wx < errW; wx += 3) {
              ctx.lineTo(xPos + wx + 1.5, yPos + (wx % 6 < 3 ? 5 : 3));
            }
            ctx.stroke();
            ctx.setLineDash([]);
            // warning icon left of line
            ctx.shadowColor = "rgba(255, 200, 0, 0.9)";
            ctx.shadowBlur = 8;
            ctx.fillStyle = "rgba(255, 210, 0, 1)";
            ctx.font = "10px JetBrains Mono, monospace";
            ctx.fillText("!!", startX - 48, yPos);
            ctx.restore();
            xPos += errW;
          }

          if (showCursor) {
            ctx.fillStyle = `rgba(97, 219, 251, ${alpha * 0.6})`;
            ctx.fillText("▊", xPos, yPos);
          }

          ctx.font = "9px JetBrains Mono, monospace";
          ctx.fillStyle = `rgba(80, 150, 255, ${alpha * 0.55})`;
          const lineNum = (currentLineIndex + 1).toString().padStart(3, " ");
          ctx.fillText(lineNum, startX - 28, yPos + 2);
        }
      }

      // ---- 250 LINES REACHED STAMP ----

      // ---- Scroll progress indicator ----

      // ---- MINIMAP (hidden on mobile — only IDE syntax shows) ----
      const mmW = width > 640 ? 56 : 0;
      const mmLineH = 2.5;
      const mmPad = 4;
      const mmX = width - mmW - 10 - width * 0.005;
      const mmY = viewportStart;
      const mmH = viewportEnd - viewportStart;

      const mmTotal = allTypedLines.length;

      // how many lines fit in the minimap
      const mmVisibleLines = Math.floor(mmH / mmLineH);
      // scroll the minimap so the bottom-most typed line is always visible
      const mmFirstLine = Math.max(0, mmTotal - mmVisibleLines);
      const mmScrollTop = mmFirstLine * mmLineH;

      // background + outline
      ctx.fillStyle = "rgba(6, 10, 20, 0.10)";
      ctx.fillRect(mmX, mmY, mmW, mmH);
      ctx.strokeStyle = "rgba(80, 130, 200, 0.15)";
      ctx.lineWidth = 0.5;
      ctx.strokeRect(mmX, mmY, mmW, mmH);

      // draw lines as colored token bars, scrolled so latest lines show
      ctx.save();
      ctx.beginPath();
      ctx.rect(mmX, mmY, mmW, mmH);
      ctx.clip();

      for (let i = 0; i < mmTotal; i++) {
        const ly = mmY + i * mmLineH - mmScrollTop;
        if (ly > mmY + mmH) break;
        if (ly < mmY - mmLineH) continue;

        // warn lines in minimap — all 3
        const mmWarnDef = WARN_DEFS.find((w) => w.line === i);
        if (mmWarnDef) {
          const wPulse = 0.5 + 0.3 * Math.sin(time * 4);
          const isActiveFixing =
            !mmWarnDef.fixed &&
            warnPhase === "fixing" &&
            WARN_DEFS[activeWarnIdx]?.line === i;
          if (mmWarnDef.fixed || isActiveFixing) {
            ctx.fillStyle = `rgba(60,220,100,${wPulse * 0.55})`;
          } else {
            ctx.fillStyle = `rgba(255,70,70,${wPulse * 0.55})`;
          }
          ctx.fillRect(mmX, ly - 0.5, mmW, mmLineH + 0.5);
        }

        const toks = highlightPrettier(allTypedLines[i]);
        let lx = mmX + mmPad;

        for (const tok of toks) {
          if (!tok.text.trim()) {
            lx += tok.text.length * 1.4;
            continue;
          }
          const parts = tok.color.match(/[\d.]+/g);
          const barW = Math.min(tok.text.length * 2.8, mmX + mmW - mmPad - lx);
          if (barW <= 0) break;
          if (parts && parts.length >= 3) {
            ctx.fillStyle = `rgba(${parts[0]},${parts[1]},${parts[2]},0.35)`;
          } else {
            ctx.fillStyle = "rgba(140,180,220,0.4)";
          }
          ctx.fillRect(lx, ly, barW, 1.2);
          lx += barW + 1;
          if (lx >= mmX + mmW - mmPad) break;
        }
      }

      // viewport box — mirrors where the main screen is scrolled to
      const mmTotalH = mmTotal * mmLineH;
      const visiblePx = viewportEnd - viewportStart;
      const totalContentPx = Math.max(1, mmTotal * LINE_HEIGHT);
      const mmViewH = Math.max(12, (visiblePx / totalContentPx) * mmTotalH);
      // offset by mmScrollTop so the box tracks within the scrolled minimap
      const mmViewY =
        mmY + (effectiveScroll / totalContentPx) * mmTotalH - mmScrollTop;

      // shaded fill inside viewport box
      ctx.fillStyle = "rgba(120, 180, 255, 0.06)";
      ctx.fillRect(mmX, mmViewY, mmW, mmViewH);
      // crisp outline
      ctx.strokeStyle = "rgba(160, 200, 255, 0.45)";
      ctx.lineWidth = 1;
      ctx.strokeRect(mmX + 0.5, mmViewY + 0.5, mmW - 1, mmViewH - 1);

      ctx.restore(); // minimap clip restore
      ctx.restore(); // end 2° rotation

      // ---- FLOATING SNIPPETS ----
      const snippets = [
        "const grid = new Blueprint()",
        "function measure() {",
        "  return tolerance;",
        "}",
        "export { precision }",
      ];

      for (let i = 0; i < snippets.length; i++) {
        const xPos =
          width * 0.04 + i * 55 + Math.sin(time * 0.2 + i * 0.7) * 10;
        const yPos = height * 0.88 + Math.sin(time * 0.15 + i * 0.5) * 6;
        const alpha = 0.015 + 0.01 * (0.5 + 0.5 * Math.sin(time * 0.3 + i));

        ctx.font = "9px JetBrains Mono, monospace";
        ctx.fillStyle = `rgba(80, 170, 255, ${alpha})`;
        ctx.fillText(snippets[i], xPos, yPos);
      }

      // ---- DIMENSION LINES ----
      ctx.lineWidth = 0.2;
      for (let i = 0; i < 6; i++) {
        const angle = time * 0.1 + i * 1.2;
        const radius = 60 + i * 25;
        const x1 = centerX + Math.cos(angle) * radius;
        const y1 = centerY + Math.sin(angle) * radius;
        const x2 = centerX + Math.cos(angle + 0.3) * (radius + 15);
        const y2 = centerY + Math.sin(angle + 0.3) * (radius + 15);

        const alpha = 0.008 * (0.5 + 0.5 * Math.sin(time * 0.2 + i));
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.strokeStyle = `rgba(80, 160, 255, ${alpha})`;
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(x2, y2, 1.5, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(80, 160, 255, ${alpha * 0.5})`;
        ctx.fill();
      }
    }

    function animate(timestamp) {
      drawBlueprint(timestamp);
      animationId = requestAnimationFrame(animate);
    }

    function init() {
      resizeCanvas();

      window.addEventListener("mousemove", handleMouseMove);
      window.addEventListener("mouseleave", handleMouseLeave);
      window.addEventListener("wheel", handleWheel, { passive: false });

      window.addEventListener(
        "touchmove",
        (e) => {
          if (e.touches.length > 0) {
            const touch = e.touches[0];
            const rect = canvas.getBoundingClientRect();
            let mx = (touch.clientX - rect.left) / rect.width;
            let my = (touch.clientY - rect.top) / rect.height;
            targetMouseX = (mx - 0.5) * 2;
            targetMouseY = (my - 0.5) * 2;

            const startX = width * 0.44;
            const startY = height * 0.08;
            const viewportStart = height * 0.08;
            const viewportEnd = height * 0.96;
            const mouseCanvasY = my * height;
            const effectiveScroll = scrollOffset;

            if (
              mx > 0.53 &&
              mx < 0.99 &&
              mouseCanvasY > viewportStart &&
              mouseCanvasY < viewportEnd
            ) {
              const lineIndex = Math.floor(
                (mouseCanvasY - startY + effectiveScroll) / LINE_HEIGHT,
              );
              if (lineIndex >= 0 && lineIndex < allTypedLines.length) {
                hoveredLineIndex = lineIndex;
              } else {
                hoveredLineIndex = -1;
              }
            } else {
              hoveredLineIndex = -1;
            }
          }
        },
        { passive: true },
      );
      window.addEventListener("touchend", () => {
        targetMouseX = 0;
        targetMouseY = 0;
        hoveredLineIndex = -1;
      });

      window.addEventListener("resize", () => {
        resizeCanvas();
      });

      if (animationId) cancelAnimationFrame(animationId);
      animate(0);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }

    window.addEventListener("beforeunload", () => {
      if (animationId) cancelAnimationFrame(animationId);
    });
  })();
</script>
