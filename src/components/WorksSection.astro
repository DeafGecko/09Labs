</style>

<script is:inline>
  (function () {
    function initWorksAccordion() {
      const accordion = document.getElementById("worksAccordion");
      if (!accordion || accordion.dataset.wired === "true") return;
      accordion.dataset.wired = "true";

      const slices = Array.from(accordion.querySelectorAll(".slice"));
      const isCoarsePointer = window.matchMedia(
        "(hover: none), (pointer: coarse)",
      ).matches;

      function activate(target) {
        slices.forEach((slice) => {
          const active = slice === target;
          slice.classList.toggle("is-active", active);
          slice.setAttribute("aria-expanded", active ? "true" : "false");
        });
      }

      slices.forEach((slice) => {
        slice.addEventListener("click", () => activate(slice));

        slice.querySelectorAll(".project-link").forEach((link) => {
          link.addEventListener("click", (event) => event.stopPropagation());
        });

        if (!isCoarsePointer) {
          slice.addEventListener("mouseenter", () => activate(slice));
        }

        slice.addEventListener("keydown", (e) => {
          const idx = slices.indexOf(slice);
          if (e.key === "ArrowRight" || e.key === "ArrowDown") {
            e.preventDefault();
            const next = slices[Math.min(idx + 1, slices.length - 1)];
            next.focus();
            activate(next);
          } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
            e.preventDefault();
            const prev = slices[Math.max(idx - 1, 0)];
            prev.focus();
            activate(prev);
          } else if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            activate(slice);
          }
        });
      });

      accordion.addEventListener("mouseleave", () => {
        if (!isCoarsePointer) {
          const first = slices[0];
          if (first) activate(first);
        }
      });

      const modal = document.getElementById("caseStudyModal");
      const closeButton = modal?.querySelector("[data-case-study-close]");
      const title = document.getElementById("caseStudyTitle");
      const eyebrow = document.getElementById("caseStudyEyebrow");
      const summary = document.getElementById("caseStudySummary");
      const tags = document.getElementById("caseStudyTags");
      const github = document.getElementById("caseStudyGithub");
      const website = document.getElementById("caseStudyWebsite");
      let trigger = null;

      function setModalLink(link, url) {
        if (!link) return;
        link.hidden = !url;
        if (url) link.setAttribute("href", url);
        else link.removeAttribute("href");
      }

      accordion
        .querySelectorAll("[data-case-study-trigger]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            if (!modal) return;
            trigger = button;
            title.textContent = button.dataset.title;
            eyebrow.textContent = button.dataset.eyebrow;
            summary.textContent = button.dataset.summary;
            tags.replaceChildren();

            JSON.parse(button.dataset.tags || "[]").forEach((tag) => {
              const item = document.createElement("span");
              item.className = "case-study-tag";
              item.textContent = tag;
              tags.append(item);
            });

            setModalLink(github, button.dataset.githubUrl);
            setModalLink(website, button.dataset.websiteUrl);
            modal.showModal();
            closeButton?.focus();
          });
        });

      closeButton?.addEventListener("click", () => modal?.close());
      modal?.addEventListener("click", (event) => {
        if (event.target === modal) modal.close();
      });
      modal?.addEventListener("close", () => trigger?.focus());
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initWorksAccordion);
    } else {
      initWorksAccordion();
    }
  })();
</script>
