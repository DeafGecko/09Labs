---
import { FileSearch } from "lucide-react";

export interface WorkItem {
  eyebrow: string;
  title: string[];
  category: string;
  summary?: string;
  tags?: string[];
  caseStudyUrl?: string;
  githubUrl?: string;
  websiteUrl?: string;
  /** optional real screenshot — falls back to a generated pattern */
  image?: string;
}

export interface Props {
  heading?: string;
  hint?: string;
  works?: WorkItem[];
}

const {
  heading = "SELECTED WORKS",
  hint = "Hover or tap vertical slices to expand project architecture & technical specs.",
  works = [
    {
      eyebrow: "VENUE OPERATIONS PLATFORM",
      title: ["THE FACTORY"],
      category: "factory",
      summary:
        "A full booking and admin platform for venues — calendar, dashboard, role-based access, and CMS-driven theming. Currently in active development.",
      tags: ["Astro", "React", "Tailwind", "Sanity", "Cloudflare"],
      caseStudyUrl: "https://09labs.studio",
      githubUrl: "https://github.com/DeafGecko",
      websiteUrl: "https://09labs.studio",
    },
    {
      eyebrow: "DESIGN TOKEN & CONTRAST ENGINE",
      title: ["CHROMATIQUE", "STUDIO"],
      category: "chromatique",
      summary:
        "A design token and contrast auditing tool — real-time accessibility checks, live component preview, and one-click CSS variable export.",
      tags: ["Vue 3", "Vite", "Tailwind", "VueUse"],
      caseStudyUrl: "https://09labs.studio",
      githubUrl: "https://github.com/DeafGecko",
      websiteUrl: "https://09labs.studio",
    },
    {
      eyebrow: "MINIMALIST WRITING APP",
      title: ["KANSO"],
      category: "kanso",
      summary:
        "A distraction-free writing app inspired by Japanese simplicity — theme and font controls, word/paragraph limits, local file save.",
      tags: ["React", "Tailwind"],
      caseStudyUrl: "https://09labs.studio",
      githubUrl: "https://github.com/DeafGecko",
      websiteUrl: "https://09labs.studio",
    },
    {
      eyebrow: "STOREFRONT & CHECKOUT",
      title: ["SWISS E-COMMERCE"],
      category: "swiss",
      summary:
        "A responsive storefront with product filtering, cart, wishlist, and a mock checkout — built around Swiss design principles.",
      tags: ["React", "Tailwind", "Vercel"],
      caseStudyUrl: "https://09labs.studio",
      githubUrl: "https://github.com/DeafGecko",
      websiteUrl: "https://09labs.studio",
    },
    {
      eyebrow: "COMMUNICATION AID",
      title: ["CLEARCARD"],
      category: "clearcard",
      summary:
        "A card-based communication app built for the Deaf and Hard of Hearing community — fast, visual, and accessible by design.",
      tags: ["React", "PWA", "A11y"],
      caseStudyUrl: "https://09labs.studio",
      githubUrl: "https://github.com/DeafGecko",
      websiteUrl: "https://09labs.studio",
    },
    {
      eyebrow: "COMPONENT LIBRARY & DESIGN SYSTEM",
      title: ["09 FOLIO"],
      category: "folio",
      summary:
        "A neo-brutalist component library and token system — proving the bridge between design background and production engineering.",
      tags: ["React", "TypeScript", "Storybook"],
      caseStudyUrl: "https://09labs.studio",
      githubUrl: "https://github.com/DeafGecko",
      websiteUrl: "https://09labs.studio",
    },
  ],
} = Astro.props;
---

<section class="works" id="works-section" aria-label="Selected work">
  <div class="works-header">
    <div class="works-heading-block">
      <h2 class="works-title">{heading}</h2>
    </div>
    <p class="works-hint">{hint}</p>
  </div>

  <div class="works-accordion" id="worksAccordion" role="list">
    {
      works.map((work, i) => (
        <article
          class="slice"
          class:list={[{ "is-active": i === 0 }]}
          data-index={i}
          role="listitem"
          tabindex="0"
          aria-expanded={i === 0 ? "true" : "false"}
        >
          <div
            class={`slice-bg pattern-${work.category}`}
            style={work.image ? `background-image:url(${work.image})` : ""}
          />
          <div class="slice-overlay" />
          <div class="slice-topline">
            <span class="slice-number">{String(i + 1).padStart(2, "0")}</span>
          </div>
          <div class="slice-vertical-label" aria-hidden="true">
            <span class="slice-vertical-name">{work.title.join(" ")} · {String(i + 1).padStart(2, "0")}</span>
          </div>
          <div class="slice-content">
            <p class="slice-eyebrow">{work.eyebrow}</p>
            <h3 class="slice-title">
              {work.title.map((line) => (
                <>
                  {line}
                  <br />
                </>
              ))}
            </h3>
            {work.summary && (
              <p class="slice-summary">{work.summary}</p>
            )}
            {work.tags && work.tags.length > 0 && (
              <div class="slice-tags">
                {work.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </div>
          <div class="slice-links">
            {work.caseStudyUrl && (
              <button
                type="button"
                class="project-link project-case-study"
                data-case-study-trigger
                data-title={work.title.join(" ")}
                data-eyebrow={work.eyebrow}
                data-summary={
                  work.summary ??
                  "Project case study details are being prepared."
                }
                data-tags={JSON.stringify(work.tags ?? [])}
                data-github-url={work.githubUrl ?? ""}
                data-website-url={work.websiteUrl ?? ""}
                aria-label={`Open the ${work.title.join(" ")} case study`}
              >
                <FileSearch
                  className="case-study-trigger-icon"
                  size={15}
                  strokeWidth={1.8}
                  aria-hidden="true"
                />
                Case Study
              </button>
            )}
            {work.githubUrl && (
              <a
                class="project-link"
                href={work.githubUrl}
                target="_blank"
                rel="noreferrer"
                aria-label={`View ${work.title.join(" ")} on GitHub`}
                title="View GitHub repository"
              >
                <img
                  class="project-link-icon"
                  src="/github.svg"
                  alt=""
                  aria-hidden="true"
                />
              </a>
            )}
            {work.websiteUrl && (
              <a
                class="project-link"
                href={work.websiteUrl}
                target="_blank"
                rel="noreferrer"
                aria-label={`Visit ${work.title.join(" ")} website`}
                title="Open live demo"
              >
                <img
                  class="project-link-icon"
                  src="/website-icon.svg"
                  alt=""
                  aria-hidden="true"
                />
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>

  <dialog
    class="case-study-modal"
    id="caseStudyModal"
    aria-labelledby="caseStudyTitle"
  >
    <div class="case-study-panel">
      <button
        class="case-study-close"
        type="button"
        data-case-study-close
        aria-label="Close case study">×</button
      >
      <p class="case-study-kicker" id="caseStudyEyebrow"></p>
      <h3 class="case-study-title" id="caseStudyTitle"></h3>
      <p class="case-study-summary" id="caseStudySummary"></p>
      <div
        class="case-study-tags"
        id="caseStudyTags"
        aria-label="Technologies used"
      >
      </div>
      <div class="case-study-actions">
        <a
          class="case-study-action"
          id="caseStudyGithub"
          target="_blank"
          rel="noreferrer">GitHub</a
        >
        <a
          class="case-study-action"
          id="caseStudyWebsite"
          target="_blank"
          rel="noreferrer">Visit Website</a
        >
      </div>
    </div>
  </dialog>
</section>

<style>
  * {
    box-sizing: border-box;
  }

  .works {
    width: 100%;
    padding: calc(1.75rem + 10px) 6% 7rem;
    background: #dfe2e3;
    transition: background 0.3s ease;
  }

  :global(.dark) .works {
    background: #0a0e17;
  }

  .works-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 2.75rem;
  }

  .works-kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: "Azeret Mono", monospace;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.6px;
    color: #2a52cc;
    text-transform: uppercase;
    margin-bottom: 0.9rem;
  }

  :global(.dark) .works-kicker {
    color: #6a9eff;
  }

  .works-kicker .dot {
    width: 7px;
    height: 7px;
    background: #2a52cc;
    display: inline-block;
    flex-shrink: 0;
  }

  :global(.dark) .works-kicker .dot {
    background: #6a9eff;
  }

  .works-title {
    font-family: "DM Sans", sans-serif;
    font-size: clamp(2.1rem, 4.4vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: #454c56;
    margin: 0;
  }

  :global(.dark) .works-title {
    color: #eef4ff;
  }

  .works-hint {
    font-family: "Azeret Mono", monospace;
    font-size: 0.82rem;
    line-height: 1.6;
    color: #20469f;
    font-weight: 500;
    letter-spacing: 0.5px;
    max-width: 280px;
    text-align: right;
    margin: 0 0 0.35rem;
  }

  :global(.dark) .works-hint {
    color: rgba(100, 170, 255, 0.7);
  }

  .works-accordion {
    display: flex;
    align-items: stretch;
    width: 100%;
    height: min(60vh, 620px);
    min-height: 380px;
    border: 1px solid rgba(42, 82, 204, 0.15);
    border-radius: 4px;
    padding: 0.6rem;
    gap: 0.6rem;
    background: rgba(42, 82, 204, 0.02);
    overflow: hidden;
  }

  :global(.dark) .works-accordion {
    border-color: rgba(80, 150, 255, 0.15);
    background: rgba(10, 14, 23, 0.4);
  }

  @property --work-border-angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }

  @keyframes work-border-travel {
    to {
      --work-border-angle: 360deg;
    }
  }

  .slice {
    position: relative;
    flex: 1 1 0%;
    min-width: 64px;
    height: 100%;
    border: 0;
    border-radius: 4px;
    padding: 0;
    margin: 0;
    cursor: pointer;
    overflow: hidden;
    background: #384351;
    text-align: left;
    font: inherit;
    color: inherit;
    transition: flex-grow 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.dark) .slice {
    background: #12161f;
  }

  .slice::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 4;
    padding: 1px;
    border-radius: inherit;
    background: conic-gradient(
      from var(--work-border-angle),
      rgba(42, 82, 204, 0.2),
      #5a8eff,
      rgba(42, 82, 204, 0.2) 35%,
      rgba(42, 82, 204, 0.2) 100%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    pointer-events: none;
  }

  .slice:hover::before,
  .slice:focus-visible::before {
    opacity: 1;
    animation: work-border-travel 2.4s linear infinite;
  }

  .slice:focus-visible {
    outline: 2px solid #6a9eff;
    outline-offset: -2px;
    z-index: 3;
  }

  .slice.is-active {
    flex-grow: 8;
  }

  .slice-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: grayscale(1) contrast(1.15) brightness(0.55);
    transform: scale(1.04);
    transition:
      filter 0.6s ease,
      transform 0.6s ease;
  }

  .slice.is-active .slice-bg {
    filter: grayscale(1) contrast(1.1) brightness(0.75);
    transform: scale(1);
  }

  html:not(.dark) .slice-bg {
    filter: grayscale(1) contrast(0.94) brightness(1.02);
  }

  html:not(.dark) .slice.is-active .slice-bg {
    filter: grayscale(1) contrast(0.96) brightness(1.04);
  }

  /* generated circuit-like placeholder patterns — swap via the `image` prop */
  .pattern-signalcard {
    background-color: #23262f;
    background-image:
      radial-gradient(
        circle at 20% 30%,
        rgba(120, 150, 200, 0.35) 0,
        transparent 45%
      ),
      radial-gradient(
        circle at 75% 65%,
        rgba(90, 130, 190, 0.3) 0,
        transparent 40%
      ),
      repeating-linear-gradient(
        0deg,
        rgba(255, 255, 255, 0.04) 0 1px,
        transparent 1px 26px
      ),
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.04) 0 1px,
        transparent 1px 26px
      );
  }
  .pattern-voltfund {
    background-color: #1d222c;
    background-image:
      radial-gradient(
        circle at 65% 20%,
        rgba(130, 160, 210, 0.3) 0,
        transparent 50%
      ),
      repeating-linear-gradient(
        45deg,
        rgba(255, 255, 255, 0.035) 0 2px,
        transparent 2px 22px
      );
  }
  .pattern-kanso {
    background-color: #191d25;
    background-image: repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.05) 0 1px,
      transparent 1px 34px
    );
  }
  .pattern-factory {
    background-color: #21242d;
    background-image:
      radial-gradient(
        circle at 30% 70%,
        rgba(140, 165, 205, 0.28) 0,
        transparent 45%
      ),
      repeating-linear-gradient(
        0deg,
        rgba(255, 255, 255, 0.04) 0 1px,
        transparent 1px 20px
      ),
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.04) 0 1px,
        transparent 1px 20px
      );
  }
  .pattern-storyone {
    background-color: #1c2029;
    background-image: radial-gradient(
      circle at 50% 40%,
      rgba(150, 175, 215, 0.3) 0,
      transparent 55%
    );
  }
  .pattern-sift {
    background-color: #20232c;
    background-image:
      linear-gradient(180deg, rgba(150, 175, 215, 0.18) 0, transparent 60%),
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.035) 0 1px,
        transparent 1px 30px
      );
  }
  .pattern-chromatique {
    background-color: #1e1f2e;
    background-image:
      radial-gradient(
        circle at 40% 30%,
        rgba(160, 120, 220, 0.3) 0,
        transparent 45%
      ),
      radial-gradient(
        circle at 75% 70%,
        rgba(90, 160, 220, 0.25) 0,
        transparent 40%
      ),
      repeating-linear-gradient(
        60deg,
        rgba(255, 255, 255, 0.03) 0 1px,
        transparent 1px 24px
      );
  }
  .pattern-swiss {
    background-color: #1d2028;
    background-image:
      repeating-linear-gradient(
        0deg,
        rgba(255, 255, 255, 0.045) 0 1px,
        transparent 1px 18px
      ),
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.045) 0 1px,
        transparent 1px 18px
      );
  }
  .pattern-folio {
    background-color: #1a1d26;
    background-image:
      radial-gradient(
        circle at 60% 40%,
        rgba(120, 160, 210, 0.32) 0,
        transparent 50%
      ),
      repeating-linear-gradient(
        45deg,
        rgba(255, 255, 255, 0.04) 0 2px,
        transparent 2px 20px
      );
  }

  .slice-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 14, 23, 0.15) 0%,
      rgba(10, 14, 23, 0.35) 55%,
      rgba(10, 14, 23, 0.92) 100%
    );
  }

  html:not(.dark) .slice-overlay {
    background: linear-gradient(
      180deg,
      rgba(184, 191, 196, 0.08) 0%,
      rgba(174, 182, 188, 0.34) 55%,
      rgba(163, 172, 179, 0.94) 100%
    );
  }

  html:not(.dark) .pattern-signalcard,
  html:not(.dark) .pattern-kanso,
  html:not(.dark) .pattern-storyone {
    background-color: #b4bbc0;
  }

  html:not(.dark) .pattern-clearcard,
  html:not(.dark) .pattern-factory,
  html:not(.dark) .pattern-sift {
    background-color: #aeb6bc;
  }

  .slice-topline {
    position: absolute;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    z-index: 2;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .slice.is-active .slice-topline {
    opacity: 1;
    pointer-events: auto;
  }

  .slice-number {
    font-family: "Azeret Mono", monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: #6a9eff;
    background: rgba(10, 14, 23, 0.6);
    border: 1px solid rgba(106, 158, 255, 0.35);
    border-radius: 4px;
    padding: 0.3rem 0.55rem;
    white-space: nowrap;
  }

  html:not(.dark) .slice-number {
    color: #274fae;
    background: rgba(223, 226, 227, 0.82);
    border-color: rgba(42, 82, 204, 0.35);
  }

  .slice-badge {
    font-family: "Azeret Mono", monospace;
    font-size: 0.65rem;
    letter-spacing: 0.4px;
    color: #d6e6ff;
    background: rgba(10, 14, 23, 0.7);
    border: 1px solid rgba(106, 158, 255, 0.25);
    border-radius: 4px;
    padding: 0.3rem 0.6rem;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }

  .slice.is-active .slice-badge {
    opacity: 1;
    transform: translateY(0);
  }

  .slice-content {
    position: absolute;
    left: 1.1rem;
    right: 1.1rem;
    bottom: 1.1rem;
    z-index: 2;
    white-space: normal;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease, visibility 0s linear 0.25s;
  }

  .slice.is-active .slice-content {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.3s ease 0.15s, visibility 0s linear 0.15s;
  }

  .slice-links {
    position: absolute;
    right: 1.1rem;
    bottom: 1.1rem;
    z-index: 3;
    display: flex;
    gap: 0.45rem;
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition:
      opacity 0.35s ease 0.1s,
      transform 0.35s ease 0.1s;
  }

  .slice.is-active .slice-links {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .project-link {
    position: relative;
    display: inline-flex;
    width: 2.25rem;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    color: #d6e6ff;
    background: rgba(10, 14, 23, 0.72);
    border: 1px solid rgba(106, 158, 255, 0.35);
    border-radius: 4px;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .project-case-study {
    width: auto;
    gap: 0.65rem;
    padding: 0 0.8rem;
    cursor: pointer;
    font-family: "Azeret Mono", monospace;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
  }

  :global(.case-study-trigger-icon) {
    flex: 0 0 auto;
  }

  .case-study-modal {
    width: min(42rem, calc(100% - 2rem));
    max-height: calc(100vh - 2rem);
    margin: auto;
    padding: 0;
    overflow: auto;
    color: #343b45;
    background: #dfe2e3;
    border: 2px solid #2a52cc;
    border-radius: 4px;
    box-shadow: 0 24px 70px rgba(26, 42, 74, 0.22);
  }

  .case-study-modal::backdrop {
    background: rgba(26, 31, 40, 0.65);
    backdrop-filter: blur(5px);
  }

  :global(.dark) .case-study-modal {
    color: #d6e6ff;
    background: #12161f;
    border-color: #5a8eff;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.5);
  }

  .case-study-panel {
    position: relative;
    padding: clamp(1.5rem, 5vw, 3rem);
  }

  .case-study-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2.75rem;
    height: 2.75rem;
    color: #343b45;
    background: transparent;
    border: 1px solid #929ba2;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
  }

  :global(.dark) .case-study-close {
    color: #eef4ff;
    border-color: rgba(106, 158, 255, 0.4);
  }

  .case-study-close:hover {
    border-color: #2a52cc;
  }

  .case-study-kicker {
    margin: 0 3.5rem 0.75rem 0;
    color: #20469f;
    font:
      600 0.78rem/1.5 "Azeret Mono",
      monospace;
    letter-spacing: 0.6px;
    text-transform: uppercase;
  }

  :global(.dark) .case-study-kicker {
    color: #6a9eff;
  }

  .case-study-title {
    font-family: "DM Sans", sans-serif;
    margin: 0 0 1.25rem;
    font-size: clamp(2rem, 7vw, 3.5rem);
    line-height: 1;
  }

  .case-study-summary {
    max-width: 58ch;
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.75;
  }

  .case-study-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .case-study-tag {
    padding: 0.4rem 0.7rem;
    color: #173f9f;
    border: 1px solid rgba(42, 82, 204, 0.45);
    border-radius: 4px;
    font:
      600 0.75rem/1.2 "Azeret Mono",
      monospace;
  }

  :global(.dark) .case-study-tag {
    color: #8aacdf;
    border-color: rgba(106, 158, 255, 0.35);
  }

  .case-study-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .case-study-action {
    padding: 0.75rem 1rem;
    color: #173f9f;
    border: 1px solid #2a52cc;
    border-radius: 4px;
    font:
