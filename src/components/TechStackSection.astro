---
export interface TechItem {
  name: string;
  slug: string;
  icon?: string;
}

export interface Props {
  heading?: string;
}

const { heading = "Tech Stack" } = Astro.props;

const ROW_1: TechItem[] = [
  { name: "React", slug: "react" },
  { name: "Photoshop", slug: "adobephotoshop", icon: "/photoshop.svg" },
  { name: "Cloudflare", slug: "cloudflare" },
  { name: "API", slug: "openapiinitiative" },
  { name: "A11y", slug: "a11y", icon: "/a11y.svg" },
  { name: "MongoDB", slug: "mongodb" },
  { name: "GSAP", slug: "gsap" },
  { name: "Sanity", slug: "sanity" },
  { name: "Playwright", slug: "playwright", icon: "/playwright.svg" },
  { name: "TypeScript", slug: "typescript" },
  { name: "Vercel", slug: "vercel" },
  { name: "Illustrator", slug: "adobeillustrator", icon: "/illustrator.svg" },
  { name: "Redux", slug: "redux" },
  { name: "Go", slug: "go" },
];

const ROW_2: TechItem[] = [
  { name: "WCAG", slug: "wcag", icon: "/wcag.svg" },
  { name: "Node.js", slug: "nodedotjs" },
  { name: "Procreate", slug: "procreate", icon: "/procreate.svg" },
  { name: "Git", slug: "git" },
  { name: "Vue", slug: "vuedotjs", icon: "/vue.svg" },
  { name: "Jest", slug: "jest" },
  { name: "Astro", slug: "astro" },
  { name: "Adobe XD", slug: "adobexd", icon: "/adobe-xd.svg" },
  { name: "Supabase", slug: "supabase" },
  { name: "Prisma", slug: "prisma" },
  { name: "Tailwind CSS", slug: "tailwindcss" },
  { name: "Railway", slug: "railway" },
  { name: "Webflow", slug: "webflow" },
  { name: "JSON", slug: "json" },
];

const ROW_3: TechItem[] = [
  { name: "React Native", slug: "react" },
  { name: "Netlify", slug: "netlify" },
  { name: "CSS3", slug: "css3", icon: "/css3.svg" },
  { name: "Expo", slug: "expo" },
  { name: "React Testing Library", slug: "testinglibrary" },
  { name: "Next.js", slug: "nextdotjs" },
  { name: "Express", slug: "express" },
  { name: "ESLint", slug: "eslint" },
  { name: "HTML5", slug: "html5" },
  { name: "Zustand", slug: "zustand", icon: "/zustand.svg" },
  { name: "CSS", slug: "css" },
  { name: "JavaScript", slug: "javascript" },
  { name: "Premiere Pro", slug: "adobepremierepro", icon: "/premiere-pro.svg" },
];

const rows = [
  { items: ROW_1, direction: "left" as const, speed: 42 },
  { items: ROW_2, direction: "right" as const, speed: 38 },
  { items: ROW_3, direction: "left" as const, speed: 40 },
];
---

<section class="techstack" id="techstack-section" aria-label="Technology stack">
  <svg class="icon-filter-defs" aria-hidden="true" focusable="false">
    <defs>
      <filter
        id="tech-icon-outline-light"
        x="-25%"
        y="-25%"
        width="150%"
        height="150%"
        color-interpolation-filters="sRGB"
      >
        <feMorphology
          in="SourceAlpha"
          operator="dilate"
          radius="1.25"
          result="expanded"></feMorphology>
        <feComposite
          in="expanded"
          in2="SourceAlpha"
          operator="out"
          result="outline"></feComposite>
        <feFlood flood-color="#2a52cc" result="color"></feFlood>
        <feComposite in="color" in2="outline" operator="in"></feComposite>
      </filter>
      <filter
        id="tech-icon-outline-dark"
        x="-25%"
        y="-25%"
        width="150%"
        height="150%"
        color-interpolation-filters="sRGB"
      >
        <feMorphology
          in="SourceAlpha"
          operator="dilate"
          radius="1.25"
          result="expanded"></feMorphology>
        <feComposite
          in="expanded"
          in2="SourceAlpha"
          operator="out"
          result="outline"></feComposite>
        <feFlood flood-color="#6a9eff" result="color"></feFlood>
        <feComposite in="color" in2="outline" operator="in"></feComposite>
      </filter>
    </defs>
  </svg>

  <div class="techstack-header">
    <h2 class="techstack-title">{heading}</h2>
    <div class="backend-summary">
      <div class="backend-summary-label">
        <span>Backend Architect</span>
        <strong>Node.js + Express</strong>
      </div>
      <div class="backend-summary-copy">
        <p>
          I build fast, reliable backends with <strong>Node.js</strong> and{" "}
          <strong>Express</strong>. I use a blueprint approach, so every feature
          has a clear place and purpose.
        </p>
        <p>
          This keeps APIs easy to test, update, and grow. Clean routes and
          middleware help the app support more users without becoming hard to
          manage.
        </p>
      </div>
    </div>
  </div>

  <div class="marquee-group">
    {
      rows.map((row, ri) => (
        <div
          class={`marquee-row dir-${row.direction}`}
          style={`--speed:${row.speed}s`}
        >
          <div class="marquee-track">
            {[0, 1].map((dup) => (
              <div
                class="marquee-set"
                aria-hidden={dup === 1 ? "true" : undefined}
              >
                {row.items.map((item) => (
                  <div class="tech-card">
                    <span class="tech-icon">
                      <img
                        src={
                          item.icon ??
                          `https://cdn.simpleicons.org/${item.slug}/ffffff`
                        }
                        alt=""
                        loading="lazy"
                        width="44"
                        height="44"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                      />
                      <span class="tech-fallback" aria-hidden="true">
                        {item.name
                          .split(" ")
                          .map((w) => w[0])
                          .join("")
                          .slice(0, 2)
                          .toUpperCase()}
                      </span>
                    </span>
                    <span class="tech-label">{item.name}</span>
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  * {
    box-sizing: border-box;
  }

  .techstack {
    width: 100%;
    padding: calc(1.75rem + 10px) 0 9rem;
    background: #dfe2e3;
    transition: background 0.3s ease;
    overflow: hidden;
  }

  :global(.dark) .techstack {
    background: #0a0e17;
  }

  .techstack-header {
    padding: 0 6%;
    margin-bottom: 2.75rem;
  }

  .techstack-kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: "Azeret Mono", monospace;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.6px;
    color: #2a52cc;
    text-transform: uppercase;
    margin-bottom: 0.9rem;
  }

  :global(.dark) .techstack-kicker {
    color: #6a9eff;
  }

  .techstack-kicker .dot {
    width: 7px;
    height: 7px;
    background: #2a52cc;
    display: inline-block;
    flex-shrink: 0;
  }

  :global(.dark) .techstack-kicker .dot {
    background: #6a9eff;
  }

  .techstack-title {
    font-family: "DM Sans", sans-serif;
    font-size: clamp(2.1rem, 4.4vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: #454c56;
    margin: 0;
  }

  :global(.dark) .techstack-title {
    color: #eef4ff;
  }

  .backend-summary {
    display: grid;
    grid-template-columns: minmax(10rem, 0.32fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    max-width: 70rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px dashed rgba(42, 82, 204, 0.2);
  }

  :global(.dark) .backend-summary {
    border-top-color: rgba(106, 158, 255, 0.18);
  }

  .backend-summary-label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: #20469f;
    font-family: "Azeret Mono", monospace;
    font-size: 0.76rem;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .backend-summary-label strong {
    color: #454c56;
    font-size: 0.9rem;
  }

  :global(.dark) .backend-summary-label {
    color: #6a9eff;
  }

  :global(.dark) .backend-summary-label strong {
    color: #eef4ff;
  }

  .backend-summary-copy {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2.5rem);
  }

  .backend-summary-copy p {
    margin: 0;
    color: #4a5059;
    font-size: 0.96rem;
    font-weight: 500;
    line-height: 1.7;
  }

  .backend-summary-copy strong {
    color: #173f9f;
    font-weight: 700;
  }

  :global(.dark) .backend-summary-copy p {
    color: #b9c7da;
  }

  :global(.dark) .backend-summary-copy strong {
    color: #8aacdf;
  }

  .marquee-group {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding-inline: clamp(1.25rem, 6vw, 6rem);
  }

  .marquee-row {
    --edge-fade: clamp(48px, 8vw, 120px);
    position: relative;
    width: 100%;
    padding-block: 10px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 var(--edge-fade),
      #000 calc(100% - var(--edge-fade)),
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 var(--edge-fade),
      #000 calc(100% - var(--edge-fade)),
      transparent 100%
    );
  }

  .marquee-track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: marquee-left var(--speed, 40s) linear infinite;
  }

  .dir-right .marquee-track {
    animation-name: marquee-right;
  }

  .marquee-row:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-set {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-right: 1rem;
    flex-shrink: 0;
  }

  @keyframes marquee-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes marquee-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  @property --card-border-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  @keyframes card-border-travel {
    to {
      --card-border-angle: 360deg;
    }
  }

  .tech-card {
    position: relative;
    z-index: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    flex-shrink: 0;
    width: 116px;
    height: 124px;
    background: #b4bbc0;
    border: 1px solid #929ba2;
    border-radius: 4px;
    padding: 1rem 0.75rem 0.85rem;
    white-space: nowrap;
    text-align: center;
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
  }

  :global(.dark) .tech-card {
    background: #12161f;
    border-color: rgba(106, 158, 255, 0.14);
  }

  .icon-filter-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .tech-card::before {
    content: "";
    position: absolute;
    inset: -2px;
    padding: 3px;
    border-radius: inherit;
    background: conic-gradient(
      from var(--card-border-angle),
      rgba(42, 82, 204, 0.28),
      #2a52cc,
      rgba(42, 82, 204, 0.28) 35%,
      rgba(42, 82, 204, 0.28) 100%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .tech-card:hover {
    z-index: 2;
    border-color: transparent;
    box-shadow: none;
  }

  .tech-card:hover::before {
    opacity: 1;
    animation: card-border-travel 2.4s linear infinite;
  }

  .tech-icon {
    position: relative;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .tech-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform-origin: 50% 58%;
    animation: icon-orbit 3.2s ease-in-out infinite alternate;
    filter: brightness(0) saturate(100%) invert(21%) sepia(8%) saturate(650%)
      hue-rotate(176deg) brightness(86%) contrast(92%);
  }

  :global(.dark) .tech-icon img {
    filter: brightness(0) invert(1);
    opacity: 0.78;
  }

  .tech-card:hover .tech-icon img {
    filter: url("#tech-icon-outline-light");
    opacity: 1;
  }

  :global(.dark) .tech-card:hover .tech-icon img {
    filter: url("#tech-icon-outline-dark");
  }

  @keyframes icon-orbit {
    from {
      transform: rotate(-5deg) translateY(-2px);
    }
    to {
      transform: rotate(5deg) translateY(2px);
    }
  }

  .tech-fallback {
    display: none;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    font-family: "Azeret Mono", monospace;
    font-size: 0.65rem;
    font-weight: 700;
    color: #ffffff;
    background: rgba(106, 158, 255, 0.12);
    border: 1px solid rgba(106, 158, 255, 0.25);
    border-radius: 4px;
  }

  :global(.dark) .tech-fallback {
    color: rgba(255, 255, 255, 0.78);
  }

  .tech-label {
    display: flex;
    min-height: 2.7rem;
    align-items: center;
    justify-content: center;
    font-family: "Azeret Mono", monospace;
    font-size: 0.78rem;
    font-weight: 600;
    color: #343b45;
    letter-spacing: 0.2px;
    line-height: 1.25;
    white-space: normal;
  }

  :global(.dark) .tech-label {
    color: #d6e6ff;
  }

  @media (max-width: 860px) {
    .techstack {
      padding: calc(1.25rem + 10px) 0 8rem;
    }
    .techstack-header {
      padding: 0 1.4rem;
    }
    .backend-summary {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .backend-summary-copy {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
    .tech-card {
      width: 104px;
      height: 116px;
      padding: 0.85rem 0.6rem 0.75rem;
    }
    .tech-label {
      font-size: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
    .tech-icon img {
      animation: none;
    }
    .tech-card:hover::before {
      animation: none;
    }
    .marquee-row {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>
