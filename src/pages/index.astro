---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home">
  <main class="flex-1">
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <h1 class="text-4xl font-bold">Welcome to 09labs</h1>
      <p class="mt-4 text-gray-600 dark:text-gray-300">
        This is your portfolio. The theme toggle is now in the header.
      </p>
      <a 
        href="/sandbox" 
        class="mt-6 inline-block text-blue-600 dark:text-blue-400 hover:underline"
      >
        View Sandbox (isolated components)
      </a>
    </section>
  </main>
</BaseLayout>